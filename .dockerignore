# Never bake local datasets, secrets, or development junk into the image.
.git
.gitleaks.toml
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.env
.env.*
# Globstar forms: a bare `.env.*` only matches the context root, so
# sentinel-ui/.env.local (written by the Vercel CLI with a short-lived OIDC
# token) was still entering the build context and being loaded by `next build`
# ("Environments: .env.local" in the build log). Secrets must never reach an
# image layer.
**/.env
**/.env.*
!**/.env.example
# Round data (root copies), secrets & keys
transactions.csv
identity.csv
case_pack.csv
closed_cases_history.csv
*.pem
*.key
*.pfx
*.p12
# Frontend build state and deps
node_modules/
.next/
out/
docs/
tests/
logs/
artifacts/
data/prepared/
data/prepared/*
data/full_load_staging/
data/llm_calls/
data/logs/
data/app/
data/raw/
*.db
*.db-journal
*.db-shm
*.db-wal
*.md
!README.md
!data/README.md
